---
import { getCollection } from "astro:content";
import Masthead from "../../components/Masthead.astro";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectTags, onlyPublished, sortByDateDesc } from "../../lib/content";
import { site } from "../../data/site";

const allPosts = onlyPublished(await getCollection("blog"));

export async function getStaticPaths() {
  const posts = onlyPublished(await getCollection("blog"));
  return collectTags(posts).map(({ tag }) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = sortByDateDesc(allPosts.filter((post) => post.data.tags.includes(tag)));
---

<BaseLayout title={`#${tag} | ${site.author}`} description={`标签 ${tag} 下的文章`}>
  <Masthead />
  <main class="listing-page">
    <header class="page-header">
      <p class="section-kicker">Tag</p>
      <h1>#{tag}</h1>
    </header>
    <section class="post-list">
      {posts.map((post) => (
        <PostCard href={`/posts/${post.slug}/`} title={post.data.title} description={post.data.description} date={post.data.date} tags={post.data.tags} />
      ))}
    </section>
  </main>
</BaseLayout>
