---
import { getCollection } from "astro:content";
import Masthead from "../components/Masthead.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { onlyPublished, sortByDateDesc, formatDate } from "../lib/content";
import { site } from "../data/site";

const posts = sortByDateDesc(onlyPublished(await getCollection("blog")));
const grouped = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = String(post.data.date.getFullYear());
  acc[year] ??= [];
  acc[year].push(post);
  return acc;
}, {});
---

<BaseLayout title={`Archive | ${site.author}`} description="文章归档">
  <Masthead />
  <main class="listing-page archive-page">
    <header class="page-header">
      <p class="section-kicker">Archive</p>
      <h1>归档</h1>
    </header>
    {Object.entries(grouped).map(([year, entries]) => (
      <section class="archive-year">
        <h2>{year}</h2>
        {entries.map((post) => (
          <a class="archive-row" href={`/posts/${post.slug}/`}>
            <time>{formatDate(post.data.date)}</time>
            <span>{post.data.title}</span>
          </a>
        ))}
      </section>
    ))}
  </main>
</BaseLayout>
