---
import { getCollection } from "astro:content";
import Masthead from "../../components/Masthead.astro";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectTags, onlyPublished, sortByDateDesc } from "../../lib/content";
import { site } from "../../data/site";

const posts = sortByDateDesc(onlyPublished(await getCollection("blog")));
const tags = collectTags(posts);
---

<BaseLayout title={`Blog | ${site.author}`} description="文章列表">
  <Masthead />
  <main class="listing-page">
    <header class="page-header">
      <p class="section-kicker">Blog</p>
      <h1>文章</h1>
      <p>长文、项目复盘、技术判断和阶段性思考。</p>
    </header>
    <div class="filter-row" data-filter-root>
      <input type="search" placeholder="Search posts..." data-filter-input />
      <div class="tag-cloud">
        {tags.map(({ tag, count }) => <a href={`/tags/${tag}/`}>#{tag}<span>{count}</span></a>)}
      </div>
    </div>
    <section class="post-list" data-filter-list>
      {posts.map((post) => (
        <div data-filter-item={`${post.data.title} ${post.data.description} ${post.data.tags.join(" ")}`}>
          <PostCard
            href={`/posts/${post.slug}/`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
          />
        </div>
      ))}
    </section>
  </main>
  <script is:inline>
    const input = document.querySelector("[data-filter-input]");
    const items = [...document.querySelectorAll("[data-filter-item]")];
    input?.addEventListener("input", () => {
      const q = input.value.toLowerCase().trim();
      for (const item of items) {
        item.hidden = q && !item.dataset.filterItem.toLowerCase().includes(q);
      }
    });
  </script>
</BaseLayout>
