---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { onlyPublished, sortByDateDesc, formatDate } from "../lib/content";
import { moments, photos, projects, site, socials } from "../data/site";

const posts = sortByDateDesc(onlyPublished(await getCollection("blog"))).slice(0, 4);
const notes = sortByDateDesc(onlyPublished(await getCollection("notes"))).slice(0, 5);
const feedItems = [
  ...posts.map((post) => ({
    type: "文章",
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    href: `/posts/${post.slug}/`,
    tags: post.data.tags
  })),
  ...notes.map((note) => ({
    type: "随笔",
    title: note.data.title,
    description: note.data.description,
    date: note.data.date,
    href: `/notes/${note.slug}/`,
    tags: note.data.tags
  }))
].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 7);
---

<BaseLayout title={site.title} description={site.description}>
  <main class="journal-home">
    <header class="journal-hero">
      <div class="journal-identity">
        <div class="soft-avatar" aria-hidden="true">R</div>
        <div>
          <p class="soft-kicker">Personal Journal</p>
          <h1>{site.author}</h1>
          <p>{site.role} · {site.location}</p>
        </div>
      </div>
      <nav class="journal-nav" aria-label="Home links">
        <a href="/blog/">文章</a>
        <a href="/notes/">随笔</a>
        <a href="/photos/">照片</a>
        <a href="/friends/">朋友</a>
        <a class="write-link" href="/admin/?quick=note">写随笔</a>
      </nav>
    </header>

    <section class="journal-intro">
      <p class="soft-kicker">Now</p>
      <h2>把每天发生的事、脑子里一闪而过的判断、正在做的小项目，认真留下来。</h2>
      <p>这里会持续记录文章、随笔、照片和项目。不是为了显得很完整，而是为了让想法有一个能被回看的地方。</p>
      <div class="soft-actions">
        {socials.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </section>

    <section class="journal-layout">
      <div class="journal-feed">
        <div class="section-heading">
          <p class="soft-kicker">Recent</p>
          <h2>最近记录</h2>
        </div>
        {feedItems.map((item) => (
          <a class="feed-card" href={item.href}>
            <div>
              <span>{item.type}</span>
              <time>{formatDate(item.date)}</time>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <footer>{item.tags.map((tag) => <small>{tag}</small>)}</footer>
          </a>
        ))}
      </div>

      <aside class="journal-side">
        <section class="side-panel quick-panel">
          <p class="soft-kicker">Capture</p>
          <h2>随手记一下</h2>
          <p>打开后台，直接写一条随笔。内容会存成 Markdown，并自动发布到博客。</p>
          <a href="/admin/?quick=note">+</a>
        </section>

        <section class="side-panel">
          <div class="section-heading compact">
            <p class="soft-kicker">Moments</p>
            <h2>动态</h2>
          </div>
          {moments.slice(0, 3).map((moment) => (
            <div class="soft-moment">
              <time>{moment.date}</time>
              <p>{moment.text}</p>
            </div>
          ))}
        </section>

        <section class="side-panel">
          <div class="section-heading compact">
            <p class="soft-kicker">Projects</p>
            <h2>项目</h2>
          </div>
          {projects.map((project) => (
            <div class="soft-project">
              <strong>{project.name}</strong>
              <p>{project.description}</p>
            </div>
          ))}
        </section>
      </aside>
    </section>

    <section class="photo-band">
      <div class="section-heading">
        <p class="soft-kicker">Photos</p>
        <h2>最近看到的画面</h2>
      </div>
      <div class="soft-photo-grid">
        {photos.slice(0, 6).map((photo) => <img src={photo.src} alt={photo.title} loading="lazy" />)}
      </div>
    </section>

    <footer class="journal-footer">
      <span>Updated {formatDate(new Date())}</span>
      <a href="/rss.xml">RSS</a>
    </footer>
  </main>
</BaseLayout>
